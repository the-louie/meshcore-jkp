# Cloudflare Pages response headers (from a modern-web-guidance security audit, 2026-11-15).
#
# Enforced: no plugins, no <base> hijack, no framing, forms post only here, and scripts only from
# this site plus the three inline scripts listed by hash (theme, motion, Plausible init; template
# v0.42.0 built with `hugo --minify`). Report-only from 2026-11-15; enforced 2026-11-16 after a
# headless check of all 66 pages, the search, the map and the wizards' pickers: 0 violations.
# Any change to an inline script in the template (see its CHANGELOG) needs new hashes here,
# or that script stops running.
# 'wasm-unsafe-eval' is for Pagefind; blob: workers for MapLibre.
# HSTS raised step by step: 300 (2026-11-15), 86400 (2026-11-16), then 31536000.
/*
  Content-Security-Policy: object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-JY+HQEUVCvAfSDIkt62Af7zLBs3AvpUTZSQsgf1sC5o=' 'sha256-baA9qojJ3UDpPMd2+kFcIgQNuTH5DT4LpY+8TMIdh40=' 'sha256-XY9QgB5Vx97My2e6MxeTjxK9VpVJljda9Vs7yW06e38=' 'wasm-unsafe-eval' 'report-sample'; worker-src 'self' blob:
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), bluetooth=(), payment=(), serial=(self)
  Strict-Transport-Security: max-age=86400

# Fingerprinted assets never change under the same name: cache them for a year.
# /lib/ holds versioned folders (maplibre-gl/<version>/, popover-polyfill/<version>/).
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/beacon/*
  Cache-Control: public, max-age=31536000, immutable
/lib/*
  Cache-Control: public, max-age=31536000, immutable
